# ============================================================================
# Apex Intelligence Engine — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================================

# ── Paper Trading Capital ─────────────────────────────────────────────────────
APEX_SYMBOL=BTCUSDT
APEX_INITIAL_CAPITAL=1000.0

# ── Execution Mode ────────────────────────────────────────────────────────────
# Set APEX_DEMO_MODE=true to place real orders on Broker (play money / demo)
# Set APEX_DEMO_MODE=false for pure paper trading (no broker connection)
APEX_DEMO_MODE=false

# Choose Broker: "bybit" or "mt5"
APEX_BROKER=mt5

# ── MetaTrader 5 (XM Global / MT5 Brokers) ──────────────────────────────────
# Set your XM Demo Account details:
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=XMGlobal-MT5
MT5_PATH=C:\Program Files\XM Global MT5\terminal64.exe

# Set APEX_HEADLESS=true when running on a server (no terminal dashboard)
# Logs will go to logs/apex.log instead
APEX_HEADLESS=false

# ── Bybit Testnet API Keys ────────────────────────────────────────────────────
# Get from: https://testnet.bybit.com/en/app/user/api-management
# (Demo Trading → API Management → Create New Key → System-generated → Read-Write)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Set BYBIT_USE_DEMO=true if using Demo Trading keys (testnet.bybit.com orange badge)
# Set BYBIT_USE_DEMO=false if using actual Bybit Testnet separate account
BYBIT_USE_DEMO=true

# ── Telegram Alerts (Optional) ───────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
# Get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

