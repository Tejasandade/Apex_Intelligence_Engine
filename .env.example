# ============================================================================
# Apex Intelligence Engine — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================================

# ── Paper Trading Capital ─────────────────────────────────────────────────────
APEX_SYMBOL=BTCUSDT
APEX_INITIAL_CAPITAL=1000.0

# ── Execution Mode ────────────────────────────────────────────────────────────
# Set APEX_DEMO_MODE=true to place real orders on Bybit TESTNET (play money)
# Set APEX_DEMO_MODE=false for pure paper trading (no broker connection)
APEX_DEMO_MODE=false

# Set APEX_HEADLESS=true when running on a server (no terminal dashboard)
# Logs will go to logs/apex.log instead
APEX_HEADLESS=false

# ── Bybit Testnet API Keys ────────────────────────────────────────────────────
# Get from: https://testnet.bybit.com/en/app/user/api-management
# (Demo Trading → API Management → Create New Key → System-generated → Read-Write)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ── Telegram Alerts (Optional) ───────────────────────────────────────────────
# Get bot token from @BotFather on Telegram
# Get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
